    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"type\": {\n      \"type\": \"string\"\n    },\n    \"confidence\": {\n      \"type\": \"number\"\n    }\n  },\n  \"required\": [\n    \"type\",\n    \"confidence\"\n  ]\n}"
      },
      "id": "e5cebbe7-670f-433d-85cf-338730df80a4",
      "name": "Issue Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        928,
        432
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst raw = item.output ?? item;\n\nconst aliases = {\n  bug: 'bug',\n  defect: 'bug',\n  error: 'bug',\n  task: 'task',\n  question: 'task',\n  'how-to': 'task',\n  support: 'task',\n  feature: 'feature',\n  'feature-request': 'feature',\n  'feature_request': 'feature',\n  enhancement: 'feature',\n  unknown: 'unknown',\n  other: 'unknown',\n};\nconst key = String(raw.type ?? '').trim().toLowerCase();\nconst type = aliases[key] ?? 'unknown';\n\nlet confidence = Number(raw.confidence);\nif (!Number.isFinite(confidence)) confidence = 0;\nconfidence = Math.max(0, Math.min(1, confidence));\n\nreturn [{ json: { type, confidence } }];"
      },
